# Data, manifests, experiment outputs, and logs stay local.
# Keep only the four empty-directory scaffolds in version control.
/data/**
!/data/raw/
!/data/raw/.gitkeep
!/data/processed/
!/data/processed/.gitkeep
!/data/metadata/
!/data/metadata/.gitkeep
/runs/
/logs/**
!/logs/.gitkeep
/checkpoints/
/artifacts/
/outputs/

